<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- Sprite — larger and properly constrained -->
    <ImageView android:id="@+id/iv_picker_sprite"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"/>

    <!-- Dex number -->
    <TextView android:id="@+id/tv_picker_dex_num"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="#888888"/>

    <!-- Name -->
    <TextView android:id="@+id/tv_picker_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingStart="4dp"/>

    <!-- Type icon badges -->
    <LinearLayout android:id="@+id/ll_picker_types"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="4dp"/>

    <TextView android:id="@+id/tv_picker_types"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:visibility="gone"/>

</LinearLayout>
