<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- Top row: sprite (left) | types + BP (right) -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Sprite -->
        <ImageView
            android:id="@+id/iv_route_sprite"
            android:layout_width="54dp" android:layout_height="54dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>

        <!-- Right column: type icons side by side, BP below -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginStart="10dp">

            <!-- Type icons horizontal -->
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_route_type1"
                    android:layout_width="26dp" android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>

                <ImageView
                    android:id="@+id/iv_route_type2"
                    android:layout_width="26dp" android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="2dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- BP -->
            <TextView
                android:id="@+id/tv_route_bp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textStyle="bold"
                android:textColor="#CC0000"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Pokémon name — left-aligned, below the sprite -->
    <TextView
        android:id="@+id/tv_route_pokemon_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="8sp"
        android:gravity="start"
        android:maxLines="1" android:ellipsize="end"
        android:paddingStart="2dp"
        android:layout_marginTop="2dp"/>

</LinearLayout>
