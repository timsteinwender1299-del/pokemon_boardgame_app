<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- Card row: sprite (left) | info (right) -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Sprite -->
        <ImageView
            android:id="@+id/iv_route_sprite"
            android:layout_width="72dp" android:layout_height="72dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>

        <!-- Right column: types + value1, BP + value2 -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <!-- Row 1: type icons + Value 1 (blue) -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_route_type1"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>

                <ImageView
                    android:id="@+id/iv_route_type2"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="2dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_route_value1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="#00B0F0"/>

            </LinearLayout>

            <!-- Row 2: BP + Value 2 (red) -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_route_bp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="#CC0000"/>

                <TextView
                    android:id="@+id/tv_route_value2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="#FF0000"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- German name -->
    <TextView
        android:id="@+id/tv_route_pokemon_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="9sp" android:textStyle="bold"
        android:gravity="start"
        android:maxLines="1" android:ellipsize="end"
        android:paddingStart="2dp"
        android:layout_marginTop="2dp"/>

    <!-- English name -->
    <TextView
        android:id="@+id/tv_route_pokemon_name_en"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="8sp"
        android:gravity="start"
        android:maxLines="1" android:ellipsize="end"
        android:paddingStart="2dp"/>

</LinearLayout>
