<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="3dp">

    <!-- LEFT column: 30% — sprite on top, names below -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_route_sprite"
            android:layout_width="60dp" android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>

        <TextView
            android:id="@+id/tv_route_pokemon_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="9sp" android:textStyle="bold"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/tv_route_pokemon_name_en"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="8sp"
            android:maxLines="1" android:ellipsize="end"/>

    </LinearLayout>

    <!-- RIGHT column: 70% — Types+BP zone (matches sprite height), then Value aligned with names -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="7"
        android:orientation="vertical"
        android:layout_marginStart="4dp">

        <!-- Types + BP in a zone with minHeight matching sprite (60dp), centered vertically -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_route_type1"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>

                <ImageView
                    android:id="@+id/iv_route_type2"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="2dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_route_bp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold"
                android:textColor="#CC0000"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- Value row — aligned with Type1 & Type2 widths -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_route_value1"
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="#00B0F0"/>

            <TextView
                android:id="@+id/tv_route_value2"
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="#FF0000"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
