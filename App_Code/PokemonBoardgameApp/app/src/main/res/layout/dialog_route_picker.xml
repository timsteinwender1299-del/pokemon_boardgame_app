<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pokedex_dialog_shell"
    android:padding="10dp">

    <!-- Pokédex mini-header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <View android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/pokedex_lens" android:layout_marginEnd="8dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_red" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_yellow" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_green" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tv_route_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Choose Route" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Hinge -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FFFFFF"/>

    <!-- Screen panel -->
    <LinearLayout android:id="@+id/screen_panel"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/pokedex_screen_bg">

        <!-- Two-column route list: Legendary (left) | Normal (right) -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Legendary routes — left column -->
            <LinearLayout
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⭐ Legendary" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#9b59b6" android:gravity="center"
                    android:paddingBottom="4dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_legendary_routes"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <View
                android:layout_width="1dp" android:layout_height="match_parent"
                android:background="#33FFFFFF" android:layout_marginHorizontal="4dp"/>

            <!-- Normal routes — right column -->
            <LinearLayout
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Normal" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#2983d3" android:gravity="center"
                    android:paddingBottom="4dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_normal_routes"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Random buttons row (matches WildPokemonPicker) -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp" android:paddingBottom="6dp"
            android:paddingHorizontal="4dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random_route"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="2dp"
                android:text="🎲 Random Route" android:textSize="11sp"
                android:textAllCaps="false"
                app:backgroundTint="#2983d3" app:cornerRadius="18dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random_town"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginStart="2dp"
                android:text="🏙️ Random Town" android:textSize="11sp"
                android:textAllCaps="false"
                app:backgroundTint="#9b59b6" app:cornerRadius="18dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_route"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="6dp"
            android:text="Close" android:textAllCaps="false"
            android:textColor="#CC0000"
            app:strokeColor="#CC0000" app:cornerRadius="20dp"/>

    </LinearLayout>

</LinearLayout>
