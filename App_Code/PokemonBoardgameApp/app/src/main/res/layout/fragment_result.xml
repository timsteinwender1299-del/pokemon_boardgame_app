<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pokedex_red"
    android:padding="10dp">

    <!-- Pokédex Header: Left group + Reverse indicator + Right spacer -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Left group (weight=1): lens + LEDs + title -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/pokedex_lens"
                android:layout_marginEnd="10dp"/>

            <View android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/pokedex_led_red"
                android:layout_marginEnd="4dp"/>
            <View android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/pokedex_led_yellow"
                android:layout_marginEnd="4dp"/>
            <View android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/pokedex_led_green"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Battle Result" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- Centre: reverse + assault vest indicators (non-interactive) -->
        <ImageView
            android:id="@+id/iv_reverse_indicator"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/reverse_deactivated"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>

        <ImageView
            android:id="@+id/iv_assault_vest_indicator"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/assault_vest_deactivated"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>

        <!-- Right spacer (weight=1) to keep centre exactly centred -->
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

    </LinearLayout>

    <!-- Hinge / divider line -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="@color/pokedex_hinge"
        android:layout_marginBottom="8dp"/>

    <!-- Dark screen panel -->
    <LinearLayout android:id="@+id/screen_panel"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/pokedex_screen_bg"
        android:clipToOutline="true">

        <!-- Winner banner (hidden) -->
        <TextView android:id="@+id/tv_winner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="24sp" android:textStyle="bold"
            android:gravity="center" android:paddingBottom="6dp"
            android:visibility="gone"/>

        <!-- Dice roll needed to win -->
        <TextView android:id="@+id/tv_dice_roll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold"
            android:gravity="center" android:paddingBottom="8dp"/>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Team A label row: icon + name -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:id="@+id/iv_result_label_a"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_player"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"/>
                    <TextView android:id="@+id/tv_team_a_result_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Player" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Team A trainer image + results -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingBottom="4dp">
                    <ImageView
                        android:id="@+id/iv_result_trainer_a"
                        android:layout_width="90dp" android:layout_height="wrap_content"
                        android:scaleType="fitCenter" android:adjustViewBounds="true"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone"/>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_result_a"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#33FFFFFF" android:layout_marginVertical="10dp"/>

                <!-- Team B label row: icon + name -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:id="@+id/iv_result_label_b"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_battle"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"/>
                    <TextView android:id="@+id/tv_team_b_result_label"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enemy Trainer" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Team B trainer image + results -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/iv_result_trainer_b"
                        android:layout_width="90dp" android:layout_height="wrap_content"
                        android:scaleType="fitCenter" android:adjustViewBounds="true"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone"/>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_result_b"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="Cancel" android:textSize="13sp" android:textStyle="bold"
                android:layout_marginEnd="4dp" app:cornerRadius="26dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_you_lost"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="You Lost" android:textSize="13sp" android:textStyle="bold"
                android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                app:cornerRadius="26dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_you_won"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="You Won" android:textSize="13sp" android:textStyle="bold"
                android:layout_marginStart="4dp" app:cornerRadius="26dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
