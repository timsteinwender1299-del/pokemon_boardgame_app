<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Winner banner -->
    <TextView android:id="@+id/tv_winner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="24sp" android:textStyle="bold"
        android:gravity="center" android:paddingBottom="6dp"/>

    <!-- Team totals -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="8dp">
        <TextView android:id="@+id/tv_total_a"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"
            android:gravity="center"/>
        <TextView android:id="@+id/tv_total_b"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <View android:id="@+id/divider_result"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginBottom="8dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/tv_team_a_result_label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🔴 Player" android:textSize="14sp" android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_result_a"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#33FFFFFF" android:layout_marginVertical="10dp"/>

            <TextView android:id="@+id/tv_team_b_result_label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🔵 Enemy Trainer" android:textSize="14sp" android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_result_b"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_new_battle"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="🔄  New Battle" android:textSize="15sp" android:textStyle="bold"
        android:layout_marginTop="8dp" app:cornerRadius="26dp"/>

</LinearLayout>
