<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pokedex_red"
    android:padding="10dp">

    <!-- Pokédex Header: Lens + LEDs + Title -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <View
            android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/pokedex_lens"
            android:layout_marginEnd="10dp"/>

        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/pokedex_led_red"
            android:layout_marginEnd="4dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/pokedex_led_yellow"
            android:layout_marginEnd="4dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/pokedex_led_green"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Battle Result" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Hinge / divider line -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="@color/pokedex_hinge"
        android:layout_marginBottom="8dp"/>

    <!-- Dark screen panel -->
    <LinearLayout android:id="@+id/screen_panel"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/pokedex_screen_bg">

        <!-- Winner banner (hidden) -->
        <TextView android:id="@+id/tv_winner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="24sp" android:textStyle="bold"
            android:gravity="center" android:paddingBottom="6dp"
            android:visibility="gone"/>

        <!-- Team totals -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="8dp">
            <TextView android:id="@+id/tv_total_a"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"
                android:gravity="center"/>
            <TextView android:id="@+id/tv_total_b"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <View android:id="@+id/divider_result"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginBottom="8dp"/>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/tv_team_a_result_label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🔴 Player" android:textSize="14sp" android:textStyle="bold"
                    android:paddingBottom="6dp"/>

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_result_a"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#33FFFFFF" android:layout_marginVertical="10dp"/>

                <TextView android:id="@+id/tv_team_b_result_label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🔵 Enemy Trainer" android:textSize="14sp" android:textStyle="bold"
                    android:paddingBottom="6dp"/>

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_result_b"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_new_battle"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="🔄  New Battle" android:textSize="15sp" android:textStyle="bold"
            android:layout_marginTop="8dp" app:cornerRadius="26dp"/>

    </LinearLayout>

</LinearLayout>
