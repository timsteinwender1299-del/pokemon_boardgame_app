<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_trainer_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:strokeWidth="2dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Top row: avatar + name + 4 sprites in a line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
                <TextView
                    android:id="@+id/tv_trainer_avatar"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="👤" android:textSize="38sp" android:gravity="center"
                    android:visibility="gone"/>
                <ImageView
                    android:id="@+id/iv_trainer_avatar_img"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:scaleType="centerInside" android:adjustViewBounds="true"/>
            </FrameLayout>

            <!-- Name above, sprites below -->
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tv_trainer_row_name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end"
                    android:paddingBottom="6dp"/>

                <!-- 4 sprites in a single horizontal row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView android:id="@+id/iv_slot_1"
                        android:layout_width="0dp" android:layout_height="72dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter" android:adjustViewBounds="true"
                        android:layout_marginEnd="2dp"/>
                    <ImageView android:id="@+id/iv_slot_2"
                        android:layout_width="0dp" android:layout_height="72dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter" android:adjustViewBounds="true"
                        android:layout_marginEnd="2dp"/>
                    <ImageView android:id="@+id/iv_slot_3"
                        android:layout_width="0dp" android:layout_height="72dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter" android:adjustViewBounds="true"
                        android:layout_marginEnd="2dp"/>
                    <ImageView android:id="@+id/iv_slot_4"
                        android:layout_width="0dp" android:layout_height="72dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter" android:adjustViewBounds="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginTop="10dp" android:layout_marginBottom="8dp"/>

        <!-- 3 action buttons -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_team"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp"
                android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"
                android:text=""
                app:icon="@drawable/ic_pokeball"
                app:iconSize="20dp" app:iconPadding="0dp" app:iconGravity="textStart"
                app:strokeColor="#CC0000" app:cornerRadius="18dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_load_battle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp"
                android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"
                android:text=""
                app:icon="@drawable/ic_battle"
                app:iconSize="20dp" app:iconPadding="0dp" app:iconGravity="textStart"
                app:strokeColor="#CC0000" app:cornerRadius="18dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_trainer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp"
                android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"
                android:text=""
                app:icon="@drawable/ic_garbage_bin"
                app:iconSize="20dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:iconTint="@null"
                app:strokeColor="#CC0000" app:cornerRadius="18dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
