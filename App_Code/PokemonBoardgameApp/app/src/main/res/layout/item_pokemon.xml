<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_pokemon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="2dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView android:id="@+id/iv_sprite"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:visibility="gone"/>

        <!-- Middle: name at top, type icons filling remaining space -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView android:id="@+id/tv_pokemon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView android:id="@+id/tv_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:visibility="gone"/>

            <!-- Type icons fill all remaining vertical space -->
            <LinearLayout android:id="@+id/ll_types"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"/>

        </LinearLayout>

        <!-- Right column: mega icon (top) → spacer → BP/delete (bottom) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Mega bracelet icon — top-right, only shown for Mega Pokémon -->
            <ImageView android:id="@+id/iv_mega_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitCenter"
                android:visibility="gone"/>

            <!-- Spacer pushes controls to the bottom -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- BP (normal state) -->
            <TextView android:id="@+id/tv_base_bp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingEnd="4dp"/>

            <!-- Fainted icon -->
            <ImageView android:id="@+id/iv_fainted"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_fainted"
                android:scaleType="fitCenter"
                android:visibility="gone"/>

            <!-- Revive button -->
            <ImageButton android:id="@+id/btn_revive"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_revive"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:contentDescription="Revive"
                android:visibility="gone"/>

            <!-- Delete button -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text=""
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_garbage_bin"
                app:iconSize="20dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:iconTint="@null"
                app:strokeColor="#555555"
                app:cornerRadius="16dp"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
