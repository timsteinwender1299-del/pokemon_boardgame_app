<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_pokemon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="2dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView android:id="@+id/iv_sprite"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:visibility="gone"/>

        <!-- Middle: name + type icons (small fixed row) -->
        <LinearLayout
            android:id="@+id/layout_pokemon_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView android:id="@+id/tv_pokemon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView android:id="@+id/tv_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:visibility="gone"/>

            <!-- Type icons: compact, wrap to content width -->
            <LinearLayout android:id="@+id/ll_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <ImageView android:id="@+id/iv_type_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="3dp"/>

                <ImageView android:id="@+id/iv_type_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Right column: mega icon (top, large) → spacer → bottom row [BP | fainted | revive | delete] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Mega bracelet icon — larger, top-right -->
            <ImageView android:id="@+id/iv_mega_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="fitCenter"
                android:visibility="gone"/>

            <!-- Spacer pushes bottom row down -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Level display -->
            <TextView android:id="@+id/tv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:visibility="gone"/>

            <!-- Bottom row: BP / fainted / revive — then delete -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- BP (normal state) -->
                <TextView android:id="@+id/tv_base_bp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingEnd="6dp"/>

                <!-- Fainted icon -->
                <ImageView android:id="@+id/iv_fainted"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_fainted"
                    android:scaleType="fitCenter"
                    android:visibility="gone"/>

                <!-- Revive button -->
                <ImageButton android:id="@+id/btn_revive"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_revive"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    android:contentDescription="Revive"
                    android:visibility="gone"/>

                <!-- Delete button -->
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text=""
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:icon="@drawable/ic_garbage_bin"
                    app:iconSize="20dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:iconTint="@null"
                    app:strokeColor="#555555"
                    app:cornerRadius="16dp"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
