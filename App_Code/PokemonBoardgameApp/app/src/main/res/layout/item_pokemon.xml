<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_pokemon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="2dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <ImageView android:id="@+id/iv_sprite"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView android:id="@+id/tv_pokemon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- Type icons row -->
            <LinearLayout android:id="@+id/ll_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"/>

            <TextView android:id="@+id/tv_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_base_bp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingEnd="10dp"/>

        <ImageView android:id="@+id/iv_fainted"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_fainted"
            android:scaleType="fitCenter"
            android:paddingEnd="6dp"
            android:visibility="gone"/>

        <ImageButton android:id="@+id/btn_revive"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_revive"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:paddingEnd="6dp"
            android:contentDescription="Revive"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text=""
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:icon="@drawable/ic_garbage_bin"
            app:iconSize="24dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:iconTint="@null"
            app:strokeColor="#555555"
            app:cornerRadius="16dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
