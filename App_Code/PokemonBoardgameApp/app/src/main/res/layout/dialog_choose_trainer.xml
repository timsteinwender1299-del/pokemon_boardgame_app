<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/pokedex_dialog_shell"
    android:padding="10dp">

    <!-- Pokédex mini-header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <View android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/pokedex_lens" android:layout_marginEnd="8dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_red" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_yellow" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_green" android:layout_marginEnd="8dp"/>
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Choose Trainer"
            android:textSize="11sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Hinge -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FFFFFF"/>

    <!-- Screen panel -->
    <LinearLayout android:id="@+id/screen_panel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/pokedex_screen_bg"
        android:paddingHorizontal="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_trainer_chooser"
            android:layout_width="match_parent" android:layout_height="440dp"/>

        <!-- Close button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_close_dialog"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Close" android:textAllCaps="false" android:textColor="#CC0000"
            app:strokeColor="#CC0000" app:cornerRadius="22dp"/>

    </LinearLayout>

</LinearLayout>
