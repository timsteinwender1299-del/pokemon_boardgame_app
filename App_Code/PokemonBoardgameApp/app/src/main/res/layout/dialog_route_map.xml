<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <!-- Zoomable/pannable Sinnoh map -->
        <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
            android:id="@+id/iv_route_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Transparent overlay draws hotspot circles -->
        <com.pokemonbp.ui.RouteMapOverlayView
            android:id="@+id/v_route_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"/>

        <!-- Route name label — shown while finger is on/near a hotspot -->
        <TextView
            android:id="@+id/tv_route_hover_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_route_hover_label"
            android:visibility="invisible"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Close button — floats over top-right corner -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_route_map"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textSize="16sp"
        android:backgroundTint="#CC333333"
        app:cornerRadius="22dp"/>

</FrameLayout>
