<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_popup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="12dp"
    app:strokeWidth="3dp"
    app:cardElevation="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Header: name + action buttons only -->
        <LinearLayout
            android:id="@+id/ll_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_popup_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="4dp"/>

            <ImageButton
                android:id="@+id/btn_popup_lock_xp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:layout_marginEnd="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock_open"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lock XP"/>

            <ImageButton
                android:id="@+id/btn_popup_faint"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="4dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fainted"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Faint"/>

            <ImageButton
                android:id="@+id/btn_popup_delete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_garbage_bin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"/>

        </LinearLayout>

        <!-- Body: Sprite | Types | spacer | Evo/Devo | spacer | Right column -->
        <LinearLayout
            android:id="@+id/ll_body"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ll_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Sprite: fills full body height -->
            <ImageView
                android:id="@+id/iv_popup_sprite"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

            <!-- Type icons stacked vertically, fill body height -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/iv_popup_type1"
                    android:layout_width="60dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>

                <ImageView
                    android:id="@+id/iv_popup_type2"
                    android:layout_width="60dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Evo/Devo buttons side by side -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_popup_evolve"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:padding="2dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Evolve"/>

                <ImageButton
                    android:id="@+id/btn_popup_devolve"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Devolve"/>

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Right column: Level | XP bar | BP + items -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical|end"
                android:layout_marginStart="4dp">

                <!-- Level row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_popup_level_minus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="14sp"
                        android:backgroundTint="#CC0000"
                        app:cornerRadius="14dp"/>

                    <TextView
                        android:id="@+id/tv_popup_level_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:paddingHorizontal="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_popup_level_plus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="14sp"
                        android:backgroundTint="#2E7D32"
                        app:cornerRadius="14dp"/>

                    <!-- Level-up button: only visible when XP is full -->
                    <ImageButton
                        android:id="@+id/btn_popup_level_up"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="2dp"
                        android:layout_marginStart="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_update"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:visibility="gone"
                        android:contentDescription="Level Up"/>

                </LinearLayout>

                <!-- XP bar row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XP:"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp"/>

                    <LinearLayout
                        android:id="@+id/ll_popup_xp_bar"
                        android:layout_width="420dp"
                        android:layout_height="14dp"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <View
                            android:id="@+id/xp_seg_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"/>

                        <View
                            android:id="@+id/xp_seg_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"/>

                        <View
                            android:id="@+id/xp_seg_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"/>

                        <View
                            android:id="@+id/xp_seg_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Bottom: item slots (left, fill height) + BP controls (right, centred) -->
                <LinearLayout
                    android:layout_width="448dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <!-- 3 item slots — fill full height of this row -->
                    <ImageButton
                        android:id="@+id/btn_popup_item_1"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_item_placeholder"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Item Slot 1"/>

                    <ImageButton
                        android:id="@+id/btn_popup_item_2"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:layout_marginStart="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_item_placeholder"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Item Slot 2"/>

                    <ImageButton
                        android:id="@+id/btn_popup_item_3"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:layout_marginStart="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_item_placeholder"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Item Slot 3"/>

                    <!-- push BP controls to the right -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_popup_bp_minus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:backgroundTint="#CC0000"
                        app:cornerRadius="18dp"/>

                    <TextView
                        android:id="@+id/tv_popup_bp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_popup_bp_plus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:backgroundTint="#2E7D32"
                        app:cornerRadius="18dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
