<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pokedex_dialog_shell"
    android:padding="10dp">

    <!-- Pokédex mini-header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <View android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/pokedex_lens" android:layout_marginEnd="8dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_red" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_yellow" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_green" android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tv_pokemon_grid_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="10sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:includeFontPadding="false"
            android:maxLines="2"/>
    </LinearLayout>

    <!-- Hinge -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FFFFFF"/>

    <!-- Screen panel — fills remaining height so RecyclerView can scroll -->
    <LinearLayout
        android:id="@+id/screen_panel_grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/pokedex_screen_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_pokemon_grid"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:padding="4dp"
            android:clipToPadding="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_pokemon_grid"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:layout_marginVertical="8dp"
            android:text="Back" android:textAllCaps="false"
            android:textColor="#CC0000"
            app:strokeColor="#CC0000" app:cornerRadius="20dp"/>

    </LinearLayout>

</LinearLayout>
