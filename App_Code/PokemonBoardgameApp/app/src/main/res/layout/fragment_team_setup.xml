<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pokedex_red"
    android:padding="10dp">

    <!-- Pokédex Header: Lens + LEDs + Title + Theme -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Blue camera lens — back button when a panel is open -->
        <View
            android:id="@+id/iv_lens"
            android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/pokedex_lens"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>

        <!-- LED indicators -->
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/pokedex_led_red"
            android:layout_marginEnd="4dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/pokedex_led_yellow"
            android:layout_marginEnd="4dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/pokedex_led_green"
            android:layout_marginEnd="10dp"/>

        <!-- App title -->
        <TextView android:id="@+id/tv_app_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="BP Calculator" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"/>

        <!-- Update data button -->
        <ImageView
            android:id="@+id/iv_update_button"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_update"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- Wild Pokémon button -->
        <ImageView
            android:id="@+id/iv_wild_button"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_wild_pokemon_menu"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Hinge / divider line -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="@color/pokedex_hinge"
        android:layout_marginBottom="8dp"/>

    <!-- Dark screen panel — theme background applied here in code -->
    <LinearLayout android:id="@+id/screen_panel"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/pokedex_screen_bg"
        android:clipToOutline="true">

        <!-- Wild Pokémon route columns (visible only in wild mode) -->
        <LinearLayout
            android:id="@+id/layout_wild_routes"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Route columns row -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Legendary routes — left column -->
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⭐ Legendary" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#9b59b6" android:gravity="center"
                        android:paddingBottom="4dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_legendary_routes"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#33FFFFFF" android:layout_marginHorizontal="4dp"/>

                <!-- Normal routes — right column -->
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Normal" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#2983d3" android:gravity="center"
                        android:paddingBottom="4dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_normal_routes"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false"/>
                </LinearLayout>

            </LinearLayout>

            <!-- RollSheet buttons row -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp" android:paddingBottom="2dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rollsheet_route"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:layout_marginEnd="2dp"
                    android:text="📋 Route" android:textSize="9sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#CC0000" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rollsheet_town"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="📋 Town Event" android:textSize="9sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#CC0000" app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rollsheet_galactic"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:layout_marginStart="2dp"
                    android:text="📋 GalacticTime!" android:textSize="9sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#880000" app:cornerRadius="16dp"/>
            </LinearLayout>

            <!-- Random buttons row -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp" android:paddingBottom="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_random_route"
                    android:layout_width="0dp" android:layout_height="36dp"
                    android:layout_weight="1" android:layout_marginEnd="2dp"
                    android:text="🎲 Random Route" android:textSize="11sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#2983d3"
                    app:cornerRadius="18dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_random_town"
                    android:layout_width="0dp" android:layout_height="36dp"
                    android:layout_weight="1" android:layout_marginStart="2dp"
                    android:text="🏙️ Random Town" android:textSize="11sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#9b59b6"
                    app:cornerRadius="18dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Route Detail (visible when a route is tapped in wild mode) -->
        <LinearLayout
            android:id="@+id/layout_route_detail"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:id="@+id/tv_route_back"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="← Back" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="#2983d3" android:paddingEnd="12dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <TextView
                    android:id="@+id/tv_route_detail_name"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp" android:textStyle="bold"
                    android:maxLines="2"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_route_pokemon"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false"/>
        </LinearLayout>

        <!-- RollSheet Detail (visible when a rollsheet button is tapped in wild mode) -->
        <LinearLayout
            android:id="@+id/layout_rollsheet"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:id="@+id/tv_rollsheet_back"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="← Back" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="#2983d3" android:paddingEnd="12dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <TextView
                    android:id="@+id/tv_rollsheet_title_inline"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp" android:textStyle="bold"
                    android:maxLines="2"/>
            </LinearLayout>

            <!-- Column headers -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Event" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#9b59b6"/>
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:text="Beschreibung" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#9b59b6"/>
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Min." android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#00B0F0" android:gravity="center"/>
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Max." android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#FF0000" android:gravity="center"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#33FFFFFF" android:layout_marginBottom="4dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rollsheet"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false"/>

        </LinearLayout>

        <!-- Panel: Add Pokémon inline -->
        <FrameLayout
            android:id="@+id/layout_panel_add_pokemon"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Panel: Add Trainer inline -->
        <FrameLayout
            android:id="@+id/layout_panel_add_trainer"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Panel: Choose Trainer inline -->
        <FrameLayout
            android:id="@+id/layout_panel_choose_trainer"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Generic sub-panel for pickers (Pokédex, Route, Starter, Enemy Trainer, etc.) -->
        <FrameLayout
            android:id="@+id/layout_panel_sub"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- BP Calculator content (hidden in wild mode) -->
        <LinearLayout android:id="@+id/layout_main_content"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Team A (48%) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="44"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <ImageView
                    android:id="@+id/iv_label_a"
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_player"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
                <TextView android:id="@+id/tv_team_a_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Player" android:textSize="15sp" android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <!-- Badges centered between name and buttons -->
                <LinearLayout android:id="@+id/ll_badges_display"
                    android:layout_width="0dp" android:layout_height="34dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center"
                    android:visibility="gone">
                    <ImageView android:id="@+id/iv_badge_1"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_2"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_3"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_4"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_5"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_6"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_7"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                    <ImageView android:id="@+id/iv_badge_8"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:scaleType="fitCenter" android:adjustViewBounds="true" android:alpha="0.25"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_reload_a"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_reload"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <ImageView
                    android:id="@+id/iv_deload_player"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_remove"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:visibility="gone"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <!-- Team A action buttons -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingBottom="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_pokemon_a"
                    android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="＋ Add Pokémon" android:textSize="11sp" android:textAllCaps="false"
                    app:cornerRadius="17dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_player_a"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="👤 Add Trainer" android:textSize="11sp" android:textAllCaps="false"
                    app:cornerRadius="17dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_choose_trainer_a"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="🎽 Choose Trainer" android:textSize="11sp" android:textAllCaps="false"
                    app:cornerRadius="17dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <ImageView android:id="@+id/iv_trainer_a"
                    android:layout_width="85dp" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:adjustViewBounds="true"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_team_a"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <View android:id="@+id/divider" android:layout_width="match_parent"
            android:layout_height="1dp" android:layout_marginTop="2dp" android:layout_marginBottom="6dp"/>

        <!-- Team B (48%) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="44"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <ImageView
                    android:id="@+id/iv_label_b"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_battle"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
                <TextView android:id="@+id/tv_team_b_label"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enemy Trainer" android:textSize="15sp" android:textStyle="bold"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:id="@+id/iv_reload_b"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_reload"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <ImageView
                    android:id="@+id/iv_deload_enemy"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_remove"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:visibility="gone"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_choose_enemy_b"
                android:layout_width="match_parent" android:layout_height="34dp"
                android:layout_marginBottom="6dp"
                android:text="Choose Enemy Trainer" android:textSize="12sp" android:textAllCaps="false"
                app:icon="@drawable/ic_battle" app:iconSize="18dp" app:iconPadding="6dp"
                app:iconGravity="textStart" app:cornerRadius="17dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <ImageView android:id="@+id/iv_trainer_b"
                    android:layout_width="85dp" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:adjustViewBounds="true"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_team_b"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Battle button (8%) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="8"
            android:orientation="vertical"
            android:gravity="center">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_calculate"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="  CALCULATE BATTLE" android:textSize="15sp" android:textStyle="bold"
                android:textAllCaps="false" app:cornerRadius="26dp"
                app:icon="@drawable/ic_battle"
                app:iconSize="22dp" app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:iconTint="@null"/>
        </LinearLayout>

        </LinearLayout><!-- end layout_main_content -->

    </LinearLayout><!-- end screen_panel -->

</LinearLayout>
