<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/pokedex_dialog_shell"
    android:padding="10dp">

    <!-- Pokédex mini-header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <View android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/pokedex_lens" android:layout_marginEnd="8dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_red" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_yellow" android:layout_marginEnd="3dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/pokedex_led_green" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tv_rollsheet_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="11sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Hinge -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FFFFFF"/>

    <!-- Screen panel -->
    <LinearLayout android:id="@+id/screen_panel_rollsheet"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/pokedex_screen_bg">

        <!-- Column headers -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" android:paddingTop="8dp" android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Event" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#AAAAAA"/>
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="5"
                android:text="Text" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#AAAAAA"/>
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="W20" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#AAAAAA" android:gravity="center"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rollsheet"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="4dp"
            android:nestedScrollingEnabled="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_rollsheet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
            android:layout_marginTop="4dp"
            android:text="Close" android:textAllCaps="false"
            android:textColor="#CC0000"
            app:strokeColor="#CC0000" app:cornerRadius="20dp"/>

    </LinearLayout>
</LinearLayout>
