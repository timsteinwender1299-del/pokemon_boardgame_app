<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A2A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Stars row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★  ★  ★  ★  ★"
            android:textSize="18sp"
            android:textColor="#FFD700"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:layout_marginBottom="8dp"/>

        <!-- HALL OF FAME title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HALL OF FAME"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:gravity="center"
            android:fontFamily="serif"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp"/>

        <!-- Gold divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FFD700"
            android:alpha="0.7"
            android:layout_marginBottom="24dp"/>

        <!-- Trainer image -->
        <ImageView
            android:id="@+id/iv_victory_trainer"
            android:layout_width="130dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Player name -->
        <TextView
            android:id="@+id/tv_victory_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:fontFamily="serif"
            android:layout_marginBottom="24dp"/>

        <!-- Gold divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FFD700"
            android:alpha="0.7"
            android:layout_marginBottom="20dp"/>

        <!-- Pokemon grid — two rows added programmatically -->
        <LinearLayout
            android:id="@+id/layout_victory_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layout_victory_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- Gold divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FFD700"
            android:alpha="0.7"
            android:layout_marginBottom="24dp"/>

        <!-- Stars row bottom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★  ★  ★  ★  ★"
            android:textSize="18sp"
            android:textColor="#FFD700"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:layout_marginBottom="20dp"/>

        <!-- Continue button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_victory_continue"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0A0A2A"
            android:paddingHorizontal="56dp"
            app:cornerRadius="4dp"
            app:backgroundTint="#FFD700"/>

    </LinearLayout>

</ScrollView>
