<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:background="#F5C518"
        android:layout_marginHorizontal="20dp">

        <!-- VICTORY! title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VICTORY!"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:fontFamily="serif"
            android:layout_marginBottom="16dp"/>

        <!-- Trainer image (left) + player name (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_victory_trainer"
                android:layout_width="110dp"
                android:layout_height="140dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tv_victory_player"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Player"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginBottom="10dp"/>

        <!-- Pokemon sprites row — filled programmatically -->
        <LinearLayout
            android:id="@+id/layout_victory_pokemon"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Continue button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_victory_continue"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="48dp"
            app:cornerRadius="26dp"
            app:backgroundTint="#1A1A1A"/>

    </LinearLayout>

</FrameLayout>
