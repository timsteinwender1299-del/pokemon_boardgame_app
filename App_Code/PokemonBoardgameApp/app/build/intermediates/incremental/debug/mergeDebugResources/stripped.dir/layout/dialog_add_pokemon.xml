<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <!-- Sprite preview + picker button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <ImageView android:id="@+id/iv_sprite"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:visibility="visible"
                android:background="#11000000"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_pokemon"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="  Choose Pokémon"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#CC0000"
                    app:icon="@drawable/ic_pokedex"
                    app:iconSize="32dp"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="10dp"/>

                <TextView android:id="@+id/tv_dex_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:paddingTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- BP Selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Base BP"
            android:textSize="13sp"
            android:textColor="#888888"
            android:paddingBottom="6dp"/>

        <!-- BP number grid: two rows of 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Row 1: 1–6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="1" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="2" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="3" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_4"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="4" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="5" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_6"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="6" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- Row 2: 7–12 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_7"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="7" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_8"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="8" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_9"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="9" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_10"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="10" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_11"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="11" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bp_12"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginHorizontal="2dp"
                    android:text="12" android:textSize="14sp" android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Types label -->
        <TextView android:id="@+id/tv_types_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type(s) — auto-filled, or override manually (max 2)"
            android:textSize="12sp"
            android:paddingBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_types"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <!-- Presets row: label + "Add Player" button (Team A only) + save button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView android:id="@+id/tv_presets_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Presets"
                android:textSize="13sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_player_preset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="➕ Add Player"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_preset"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="💾 Save as Preset"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:gravity="center"/>
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup android:id="@+id/preset_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
